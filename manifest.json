{
  "manifest_version": 2,
  "name": "Outlier Chat Downloader",
  "version": "1.0",
  "description": "Download Outlier Model Playground chats as Markdown files.",
  "icons": {
    "48": "icons/icon-96.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-96.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Download Chat as MD",
    "default_popup": "popup/popup.html"
  }
}